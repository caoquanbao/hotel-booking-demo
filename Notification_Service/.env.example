# =========================
# App
# =========================
PORT=3004
NODE_ENV=development
SERVICE_NAME=Notification_Service
LOG_LEVEL=info

# =========================
# Mail (SMTP)
# =========================
MAIL_ENABLED=true
MAIL_FROM=Hotel Booking Demo <no-reply@example.com>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# =========================
# Telegram Bot
# =========================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id
TELEGRAM_API_BASE_URL=https://api.telegram.org

# =========================
# RabbitMQ
# =========================
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://your_username:your_password@localhost:5672
RABBITMQ_NOTIFICATION_QUEUE=notifications.queue

# =========================
# Retry / Idempotency
# =========================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
IDEMPOTENCY_TTL_MS=3600000